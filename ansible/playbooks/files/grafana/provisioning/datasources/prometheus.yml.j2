---
apiVersion: 1

deleteDatasources:
  - name: prometheus
    orgId: 1

datasources:
  - name: prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: "http://{{ hostvars[groups['backend'][0]]['ansible_host'] }}:9090"
    isDefault: true
    editable: true
    orgId: 1

    jsonData:
      httpMethod: POST
      manageAlerts: true
      prometheusType: Prometheus
      cacheLevel: High
      disableRecordingRules: false
      incrementalQuerying: true